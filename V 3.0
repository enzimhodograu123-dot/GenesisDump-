    local Header = Instance.new("Frame")
    Header.Size = UDim2.new(1, 0, 0, 25)
    Header.BackgroundTransparency = 1
    Header.Parent = Card

    local NameLbl = Instance.new("TextLabel")
    NameLbl.Text = string.format(" [%s] %s", prefix, title)
    NameLbl.Size = UDim2.new(0.7, 0, 1, 0)
    NameLbl.BackgroundTransparency = 1
    NameLbl.TextColor3 = Color3.fromRGB(0, 255, 150)
    NameLbl.Font = Enum.Font.Code
    NameLbl.TextSize = 13
    NameLbl.TextXAlignment = Enum.TextXAlignment.Left
    NameLbl.Parent = Header

    local BtnExpand = Instance.new("TextButton")
    BtnExpand.Text = "[+]"
    BtnExpand.Size = UDim2.new(0, 30, 0, 25)
    BtnExpand.Position = UDim2.new(1, -70, 0, 0)
    BtnExpand.BackgroundTransparency = 1
    BtnExpand.TextColor3 = Color3.fromRGB(0, 200, 255)
    BtnExpand.Font = Enum.Font.Code
    BtnExpand.Parent = Header

    local BtnCopy = Instance.new("TextButton")
    BtnCopy.Text = "[C]"
    BtnCopy.Size = UDim2.new(0, 30, 0, 25)
    BtnCopy.Position = UDim2.new(1, -35, 0, 0)
    BtnCopy.BackgroundTransparency = 1
    BtnCopy.TextColor3 = Color3.fromRGB(0, 200, 255)
    BtnCopy.Font = Enum.Font.Code
    BtnCopy.Parent = Header

    local CodeBox = Instance.new("TextBox")
    CodeBox.Size = UDim2.new(1, -10, 0, 0)
    CodeBox.Position = UDim2.new(0, 5, 0, 25)
    CodeBox.BackgroundColor3 = Color3.fromRGB(2, 2, 2)
    CodeBox.BorderSizePixel = 1
    CodeBox.BorderColor3 = Color3.fromRGB(0, 50, 0)
    CodeBox.TextColor3 = Color3.fromRGB(180, 180, 180)
    CodeBox.Font = Enum.Font.Code
    CodeBox.TextSize = 12
    CodeBox.Text = code
    CodeBox.TextEditable = false
    CodeBox.ClearTextOnFocus = false
    CodeBox.TextXAlignment = Enum.TextXAlignment.Left
    CodeBox.TextYAlignment = Enum.TextYAlignment.Top
    CodeBox.AutomaticSize = Enum.AutomaticSize.Y
    CodeBox.Visible = false
    CodeBox.Parent = Card

    local expanded = false
    BtnExpand.MouseButton1Click:Connect(function()
        expanded = not expanded
        BtnExpand.Text = expanded and "[-]" or "[+]"
        CodeBox.Visible = expanded
    end)

    BtnCopy.MouseButton1Click:Connect(function()
        setclipboard(code)
        BtnCopy.Text = "[V]"
        task.wait(1)
        BtnCopy.Text = "[C]"
    end)
end

local function CreateRemoteCard(remote)
    local Card = Instance.new("Frame")
    Card.Name = "RemoteCard"
