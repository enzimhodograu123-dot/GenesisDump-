local function BuildExplorer()
    ClearResults()
    local roots = {game.Workspace, game.Players, game.ReplicatedStorage, game.ServerScriptService, game.Lighting}
    for _, root in ipairs(roots) do
        local container = Instance.new("Frame")
        container.BackgroundTransparency = 1
        container.AutomaticSize = Enum.AutomaticSize.Y
        container.Size = UDim2.new(1, 0, 0, 0)
        container.Parent = ResultsFrame
        
        local layout = Instance.new("UIListLayout")
        layout.Parent = container
        layout.SortOrder = Enum.SortOrder.LayoutOrder

        local Node = Instance.new("Frame")
        Node.BackgroundColor3 = Color3.fromRGB(8, 8, 8)
        Node.BorderSizePixel = 0
        Node.Size = UDim2.new(1, 0, 0, 20)
        Node.Parent = container

        local Lbl = Instance.new("TextLabel")
        Lbl.Text = " [+] " .. root.Name
        Lbl.Size = UDim2.new(1, 0, 1, 0)
        Lbl.TextColor3 = Color3.fromRGB(0, 255, 100)
        Lbl.Font = Enum.Font.Code
        Lbl.BackgroundTransparency = 1
        Lbl.TextXAlignment = Enum.TextXAlignment.Left
        Lbl.Parent = Node
    end
end

local function CreateExplorerNode(obj, parentFrame, level)
    local Node = Instance.new("Frame")
    Node.BackgroundColor3 = Color3.fromRGB(8, 8, 8)
    Node.BorderSizePixel = 0
    Node.Size = UDim2.new(1, 0, 0, 20)
    Node.Parent = parentFrame

    local ToggleBtn = Instance.new("TextButton")
    ToggleBtn.Text = #obj:GetChildren() > 0 and "[+]" or " "
    ToggleBtn.Size = UDim2.new(0, 25, 1, 0)
    ToggleBtn.Position = UDim2.new(0, level * 10, 0, 0)
    ToggleBtn.BackgroundTransparency = 1
    ToggleBtn.TextColor3 = Color3.fromRGB(0, 255, 100)
    ToggleBtn.Font = Enum.Font.Code
    ToggleBtn.Parent = Node

    local NameLbl = Instance.new("TextLabel")
    NameLbl.Text = obj.Name .. " (" .. obj.ClassName .. ")"
    NameLbl.Size = UDim2.new(1, -30 - (level*10), 1, 0)
    NameLbl.Position = UDim2.new(0, 30 + (level*10), 0, 0)
    NameLbl.BackgroundTransparency = 1
    NameLbl.TextColor3 = Color3.fromRGB(200, 200, 200)
    NameLbl.Font = Enum.Font.Code
    NameLbl.TextSize = 12
    NameLbl.TextXAlignment = Enum.TextXAlignment.Left
    NameLbl.Parent = Node

    local ChildrenContainer = Instance.new("Frame")
    ChildrenContainer.Size = UDim2.new(1, 0, 0, 0)
    ChildrenContainer.BackgroundTransparency = 1
    ChildrenContainer.AutomaticSize = Enum.AutomaticSize.Y
    ChildrenContainer.Visible = false
    ChildrenContainer.Parent = parentFrame
    
    local Layout = Instance.new("UIListLayout")
    Layout.Parent = ChildrenContainer
    Layout.SortOrder = Enum.SortOrder.LayoutOrder

    local loaded = false
    local expanded = false

    ToggleBtn.MouseButton1Click:Connect(function()
        if #obj:GetChildren() == 0 then return end
        expanded = not expanded
        ToggleBtn.Text = expanded and "[-]" or "[+]"
        ChildrenContainer.Visible = expanded

        if expanded and not loaded then
            loaded = true
            for _, child in ipairs(obj:GetChildren()) do
                CreateExplorerNode(child, ChildrenContainer, level + 1)
            end
        end
    end)
end

local function BuildExplorer()
    ClearResults()
    local roots = {
        game.Workspace, 
        game.Players, 
        game.ReplicatedStorage, 
        game.Lighting, 
        game.StarterGui,
        game.CoreGui -- Note: Might fail depending on exploit permissions
    }
    
    for _, root in ipairs(roots) do
        pcall(function()
            local container = Instance.new("Frame")
            container.BackgroundTransparency = 1
            container.AutomaticSize = Enum.AutomaticSize.Y
            container.Size = UDim2.new(1, 0, 0, 0)
            container.Parent = ResultsFrame
            
            local layout = Instance.new("UIListLayout")
            layout.Parent = container
            layout.SortOrder = Enum.SortOrder.LayoutOrder

            CreateExplorerNode(root, container, 0)
        end)
    end
end


local DecompiledCache = {}
local MutedRemotes = {}
local NetworkMuteHooked = false

local function ExecuteCommand(cmd)
    AddLog(cmd, "YOU")

    local args = string.split(cmd, "/")
    local action = args[2] and args[2]:lower() or ""
    local targetArg = args[3] and args[3]:lower() or ""

    if action == "" then
        AddLog("[ERROR] Invalid syntax.", "ERROR")
        return
    end

    if action == "clearset1" then
        ClearLogs()
        task.wait(0.5)
        local bootASCII = [[
,
_,,)\.~,,._
(()`  ``)\))),,_
 |     \ ''((\)))),,_ 
 |6`   |   ''((\())) "-.____.-"~~--..__
 |    .'\    ''))))'                 ~~--..__
 |   |   `.     ''                   .__        _______ _     ____ ___  __  __ _____ _
 \, _)     \/                  ~~\ \      / / ____| |   / ___/ _ \|  \/  | ____| |
  `'        |                    .\ \ /\ / /|  _| | |  | |  | | | | |\/| |  _| | |
            \                 .~~~~ \ V  V / | |___| |__| |__| |_| | |  | | |___|_|
             `|    |      .~~~~~     \_/\_/  |_____|_____\____\___/|_|  |_|_____(_) !
              |   / `-.__.~~~~
              |   |  /  ~~~
              |  / \ |
              \  | | |
               | | | |
]]

for _, line in ipairs(string.split(bootASCII, "\n")) do
    if line ~= "" then
        AddLog(line, "DEFAULT")
        task.wait(0.01)
    end
end

local msg1 = AddLog("System Boot: GenesisDump v2.0", "SYSTEM")
msg1.TextColor3 = Color3.fromRGB(255, 255, 255)

AddLog("Type '!n dump /cmds/' to see all commands.", "WARN")
        return

    elseif action == "clearset2" then
        ClearResults()
        ResultsFrame.CanvasPosition = Vector2.new(0,0)
        return

    elseif action == "explorer" then
        BuildExplorer()
        AddLog("[SYS] Explorer loaded.", "SYSTEM")
        return

    elseif action == "selfdestruct" then
        ScreenGui:Destroy()
        return

    elseif action == "timestop" then
        Lighting.ClockTime = 0
        AddLog("[SYS] Environment frozen.", "SYSTEM")
        return

    elseif action == "export" then
        if writefile then
            local exportStr = ""
            for _, v in ipairs(LogScroll:GetChildren()) do
                if v:IsA("TextLabel") then
                    exportStr ..= v.Text .. "\n"
                end
            end
            writefile("GenesisDump_Export.txt", exportStr)
            AddLog("[SYS] Exported.", "SYSTEM")
        else
            AddLog("[ERROR] writefile not supported.", "ERROR")
        end
        return

    elseif action == "cmds" then
        local commands = {
            ["/cmds/"] = "Displays this help menu.",
            ["/module/"] = "Scans and dumps all ModuleScripts.",
            ["/local/"] = "Scans and decompiles all LocalScripts.",
            ["/remote/"] = "Lists all RemoteEvents and RemoteFunctions.",
            ["/anticheats/"] = "Searches for suspicious anti-cheat scripts.",
            ["/backdoor/"] = "Scans for potential backdoors.",
            ["/explorer/"] = "Opens the instance explorer.",
            ["/timestop/"] = "Freezes environment time.",
            ["/bypass/"] = "Finds Bindables.",
            ["/remotespy/"] = "Logs remote traffic.",
            ["/networkmute/name/"] = "Blocks a remote.",
            ["/grep/keyword/"] = "Searches code keyword.",
            ["/constants/"] = "Gets constants.",
            ["/upvalues/"] = "Gets upvalues.",
            ["/playerlist/"] = "Shows players.",
            ["/esp/"] = "Highlights objects.",
            ["/hidden/"] = "Scans CoreGui.",
            ["/heavy/"] = "Finds large scripts.",
            ["/export/"] = "Exports logs.",
            ["/selfdestruct/"] = "Destroys GUI.",
            ["/clearset1/"] = "Clears logs.",
            ["/clearset2/"] = "Clears results."
        }

        for cmdName, desc in pairs(commands) do
            AddLog(string.format("%s - %s", cmdName, desc), "INFO")
        end
        return

    elseif action == "playerlist" then
        for _, p in ipairs(Players:GetPlayers()) do
            AddLog(string.format("[%d] %s | %d", p.UserId, p.Name, p.AccountAge), "INFO")
        end
        return

    elseif action == "networkmute" then
        if targetArg == "" then
            AddLog("[ERROR] Usage: /networkmute/name", "ERROR")
            return
        end

        MutedRemotes[targetArg] = true
        AddLog("[MUTED] " .. targetArg, "WARN")

        if not NetworkMuteHooked and hookmetamethod then
            NetworkMuteHooked = true

            local old
            old = hookmetamethod(game, "__namecall", function(self, ...)
                local m = getnamecallmethod()

                if not checkcaller()
                    and (m == "FireServer" or m == "InvokeServer")
                    and MutedRemotes[self.Name]
                then
                    return nil
                end

                return old(self, ...)
            end)
        end

        return

    elseif action == "remotespy" or action == "args" then
        if not RSpyHooked and hookmetamethod then
            RSpyHooked = true

            local old
            old = hookmetamethod(game, "__namecall", function(self, ...)
                local m = getnamecallmethod()

                if not checkcaller() and (m == "FireServer" or m == "InvokeServer") then
                    local remoteArgs = {...}

                    task.spawn(function()
                        CreateCodeCard(
                            self.Name,
                            Serialize(remoteArgs, 0, {}),
                            "SPY"
                        )
                    end)

                    AddLog("[SPY] " .. self.Name, "SYSTEM")
                end

                return old(self, ...)
            end)

            AddLog("[SYS] RemoteSpy active.", "SYSTEM")
        end

        return
    end

    ClearResults()

    AddLog("[SYS] Scanning started...", "PROGRESS")

    task.spawn(function()
        local found = 0
        local descendants = game:GetDescendants()

        if gethui then
            for _, v in ipairs(gethui():GetDescendants()) do
                table.insert(descendants, v)
            end
        end

        local total = #descendants

        for i, obj in ipairs(descendants) do
            if i % 150 == 0 then
                AddLog(string.format("%s %d%%", obj.Name, math.floor((i / total) * 100)), "PROGRESS")
                task.wait()
            end

            if action == "grep"
                and (obj:IsA("LocalScript") or obj:IsA("ModuleScript"))
            then
                local code = DecompiledCache[obj] or GetDecompiledCode(obj)

                DecompiledCache[obj] = code

                if code:lower():find(targetArg) then
                    found += 1
                    CreateCodeCard(obj.Name, code, "GREP")
                end

            elseif action == "module" and obj:IsA("ModuleScript") then
                found += 1

                local _, R

                task.spawn(function()
                    _, R = pcall(require, obj)
                end)

                task.wait()

                local out = "-- Path: "
                    .. ToPath(obj)
                    .. "\n\n"

                if typeof(R) == "table" then
                    for k, v in next, R do
                        out ..= tostring(k)
                            .. " = "
                            .. Serialize(v, 0, {})
                            .. "\n"
                    end
                else
                    out ..= "-- returned " .. typeof(R)
                end

                CreateCodeCard(obj.Name, out, "MD")

            elseif action == "local" and obj:IsA("LocalScript") then
                found += 1

                local out = "-- Path: "
                    .. ToPath(obj)
                    .. "\n\n"
                    .. GetDecompiledCode(obj)

                CreateCodeCard(obj.Name, out, "LC")

            elseif action == "remote"
                and (obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction"))
            then
                found += 1
                CreateRemoteCard(obj)

            elseif action == "bypass"
                and (obj:IsA("BindableEvent") or obj:IsA("BindableFunction"))
            then
                found += 1
                CreateInfoCard(obj.Name, ToPath(obj), "BP")

            elseif action == "constants"
                and (obj:IsA("LocalScript") or obj:IsA("ModuleScript"))
            then
                if getscriptclosure and debug.getconstants then
                    local s, c = pcall(getscriptclosure, obj)

                    if s and c then
                        found += 1

                        CreateCodeCard(
                            obj.Name,
                            Serialize(debug.getconstants(c), 0, {}),
                            "CT"
                        )
                    end
                end

            elseif action == "upvalues"
                and (obj:IsA("LocalScript") or obj:IsA("ModuleScript"))
            then
                if getscriptclosure and debug.getupvalues then
                    local s, c = pcall(getscriptclosure, obj)

                    if s and c then
                        found += 1

                        CreateCodeCard(
                            obj.Name,
                            Serialize(debug.getupvalues(c), 0, {}),
                            "UP"
                        )
                    end
                end

            elseif action == "esp"
                and obj.Parent
                and obj.Parent:IsA("BasePart")
            then
                if obj:IsA("LocalScript") or obj:IsA("RemoteEvent") then
                    found += 1

                    local h = Instance.new("Highlight", obj.Parent)
                    h.FillColor = Color3.fromRGB(255,0,0)

                    CreateInfoCard(obj.Name, obj.Parent.Name, "ESP")
                end

            elseif action == "heavy"
                and (obj:IsA("LocalScript") or obj:IsA("Script"))
            then
                local code = GetDecompiledCode(obj)

                if code and #code > 4000 then
                    found += 1
                    CreateCodeCard(obj.Name, code, "HV")
                end

            elseif action == "hidden" then
                if obj:IsDescendantOf(game:GetService("CoreGui")) then
                    found += 1
                    CreateInfoCard(obj.Name, ToPath(obj), "HD")
                end

            elseif action == "anticheats" then
                local n = obj.Name:lower()

                if (obj:IsA("LocalScript") or obj:IsA("ModuleScript"))
                    and (
                        n:match("anti")
                        or n:match("cheat")
                        or n:match("detect")
                        or n:match("bypass")
                        or n:match("adonis")
                        or n:match("admin")
                        or n:match("crash")
                    )
                then
                    found += 1

                    local out = "-- Suspicious Script: "
                        .. ToPath(obj)
                        .. "\n\n"

                    if obj:IsA("LocalScript") then
                        out ..= GetDecompiledCode(obj)
                    end

                    CreateInfoCard(obj.Name, out, "AC")
                end

            elseif action == "backdoor" and obj:IsA("Script") then
                local code = GetDecompiledCode(obj)

                if code and not code:match("ERROR") then
                    if code:match("getfenv")
                        or code:match("require%s*%(%d+%)")
                        or code:match("loadstring")
                    then
                        found += 1

                        CreateInfoCard(
                            obj.Name,
                            "-- Path: "
                                .. ToPath(obj)
                                .. "\n\n"
                                .. code,
                            "BD"
                        )
                    end
                end

            elseif action == "desableall" then
                if targetArg == "locals" and obj:IsA("LocalScript") then
                    obj.Disabled = true
                    found += 1

                elseif targetArg == "scripts" and obj:IsA("Script") then
                    obj.Disabled = true
                    found += 1
                end

            elseif action == "desable"
                and obj.Name:lower() == targetArg
            then
                if obj:IsA("LocalScript") or obj:IsA("Script") then
                    obj.Disabled = true
                    found += 1
                end

            elseif obj.Name:lower() == action then
                found += 1

                if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
                    CreateRemoteCard(obj)

                elseif obj:IsA("ModuleScript") then
                    local _, R

                    task.spawn(function()
                        _, R = pcall(require, obj)
                    end)

                    task.wait()

                    local out = "-- Path: "
                        .. ToPath(obj)
                        .. "\n\n"

                    if typeof(R) == "table" then
                        for k, v in next, R do
                            out ..= tostring(k)
                                .. " = "
                                .. Serialize(v, 0, {})
                                .. "\n"
                        end
                    else
                        out ..= "-- returned " .. typeof(R)
                    end

                    CreateCodeCard(obj.Name, out, "MD")

                elseif obj:IsA("LocalScript") or obj:IsA("Script") then
                    local out = "-- Path: "
                        .. ToPath(obj)
                        .. "\n\n"
                        .. GetDecompiledCode(obj)

                    CreateCodeCard(obj.Name, out, "SC")
                end
            end
        end

        AddLog("[SYS] Done: " .. found, "PROGRESS")
    end)
end




CmdInput.FocusLost:Connect(function(enterPressed)
    if enterPressed and CmdInput.Text ~= "" then
        local text = CmdInput.Text
        CmdInput.Text = ""
        ExecuteCommand(text)
    end
end)

