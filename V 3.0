local RSpyHooked = false

local function Serialize(V, D, Seen)
    if D > 3 then return "..." end
    local T = typeof(V)
    if T == "string" then return '"'..V:gsub('\\','\\\\'):gsub('"','\\"'):gsub('\n','\\n')..'"' end
    if T == "boolean" or T == "number" or T == "EnumItem" then return tostring(V) end
    if T == "function" or T == "thread" then return T end
    if T == "Vector3" then return ("Vector3.new(%g,%g,%g)"):format(V.X,V.Y,V.Z) end
    if T == "Vector2" then return ("Vector2.new(%g,%g)"):format(V.X,V.Y) end
    if T == "Color3" then return ("Color3.fromRGB(%d,%d,%d)"):format(math.floor(V.R*255),math.floor(V.G*255),math.floor(V.B*255)) end
    if T == "BrickColor" then return ('BrickColor.new("%s")'):format(V.Name) end
    if T == "UDim2" then return ("UDim2.new(%g,%g,%g,%g)"):format(V.X.Scale,V.X.Offset,V.Y.Scale,V.Y.Offset) end
    if T == "UDim" then return ("UDim.new(%g,%g)"):format(V.Scale,V.Offset) end
    if T == "CFrame" then return ("CFrame.new(%g,%g,%g,%g,%g,%g,%g,%g,%g,%g,%g,%g)"):format(V:GetComponents()) end
    if T == "Instance" then return V:GetFullName() end
    if T ~= "table" then return "["..T.."]" end
    if not next(V) then return "{}" end
    if Seen[V] then return "{...}" end
    Seen[V] = true
    local O, Pad = {}, string.rep("  ", D + 1)
    for K, Val in next, V do
        O[#O+1] = Pad..tostring(K)..(typeof(Val) == "function" and "()" or " = "..Serialize(Val, D+1, Seen))
    end
    Seen[V] = nil
    return "{\n"..table.concat(O, "\n").."\n"..string.rep("  ", D).."}"
end

local function ToPath(I)
    return I:GetFullName():gsub("^([^.]+)",'game:GetService("%1")'):gsub("%.([^.]+)",'["%1"]')
end

local function GetDecompiledCode(obj)
    local success, code = pcall(function() return decompile(obj) end)
    if success and type(code) == "string" and code ~= "" then
        return code
    end
    return "-- [ERROR] Could not decompile (Protected or Unsupported)"
end

local function AddLog(msg, logType)
    local color = Color3.fromRGB(0, 200, 0)
    if logType == "YOU" then color = Color3.fromRGB(0, 255, 255)
    elseif logType == "WARN" then color = Color3.fromRGB(255, 255, 0)
    elseif logType == "ERROR" then color = Color3.fromRGB(255, 50, 50)
    elseif logType == "SYSTEM" then color = Color3.fromRGB(150, 150, 255)
    elseif logType == "PROGRESS" then color = Color3.fromRGB(200, 200, 0) end

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, 0, 0, 16)
    lbl.BackgroundTransparency = 1
    lbl.Text = logType == "YOU" and ("«[YOU] " .. msg .. "»") or msg
    lbl.TextColor3 = color
    lbl.Font = Enum.Font.Code
    lbl.TextSize = 13
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = LogScroll
    
    task.delay(0.05, function() LogScroll.CanvasPosition = Vector2.new(0, LogLayout.AbsoluteContentSize.Y) end)
    return lbl
end

local function ClearLogs()
    for _, v in pairs(LogScroll:GetChildren()) do
        if v:IsA("TextLabel") then v:Destroy() end
    end
end

local function ClearResults()
    for _, v in pairs(ResultsFrame:GetChildren()) do
        if v:IsA("Frame") then v:Destroy() end
    end
end

local function CreateTerminalLine()
    local line = Instance.new("Frame")
    line.Size = UDim2.new(1, 0, 0, 1)
    line.BackgroundColor3 = Color3.fromRGB(0, 50, 0)
    line.BorderSizePixel = 0
    return line
end

local function CreateCodeCard(title, code, prefix)
