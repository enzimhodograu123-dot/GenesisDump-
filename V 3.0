    Card.Size = UDim2.new(1, -10, 0, 25)
    Card.Parent = ResultsFrame

    local TopLine = CreateTerminalLine()
    TopLine.BackgroundColor3 = Color3.fromRGB(50, 0, 0)
    TopLine.Parent = Card

    local NameLbl = Instance.new("TextLabel")
    NameLbl.Text = string.format(" [RE] %s", remote.Name)
    NameLbl.Size = UDim2.new(0.6, 0, 1, 0)
    NameLbl.BackgroundTransparency = 1
    NameLbl.TextColor3 = Color3.fromRGB(255, 100, 100)
    NameLbl.Font = Enum.Font.Code
    NameLbl.TextSize = 13
    NameLbl.TextXAlignment = Enum.TextXAlignment.Left
    NameLbl.Parent = Card

    local BtnFire = Instance.new("TextButton")
    BtnFire.Text = "[FIRE]"
    BtnFire.Size = UDim2.new(0, 50, 0, 25)
    BtnFire.Position = UDim2.new(1, -95, 0, 0)
    BtnFire.BackgroundTransparency = 1
    BtnFire.TextColor3 = Color3.fromRGB(255, 50, 50)
    BtnFire.Font = Enum.Font.Code
    BtnFire.Parent = Card

    local BtnCopy = Instance.new("TextButton")
    BtnCopy.Text = "[C]"
    BtnCopy.Size = UDim2.new(0, 30, 0, 25)
    BtnCopy.Position = UDim2.new(1, -35, 0, 0)
    BtnCopy.BackgroundTransparency = 1
    BtnCopy.TextColor3 = Color3.fromRGB(255, 100, 100)
    BtnCopy.Font = Enum.Font.Code
    BtnCopy.Parent = Card

    BtnFire.MouseButton1Click:Connect(function()
        pcall(function()
            if remote:IsA("RemoteEvent") then remote:FireServer()
            elseif remote:IsA("RemoteFunction") then remote:InvokeServer() end
            AddLog("[SYS] Fired Remote: " .. remote.Name, "SYSTEM")
        end)
    end)

    BtnCopy.MouseButton1Click:Connect(function()
        setclipboard(ToPath(remote))
        BtnCopy.Text = "[V]"
        task.wait(1)
        BtnCopy.Text = "[C]"
    end)
end

